        "    if y_true.device != y_pred.device:\n",
        "        y_pred = y_pred.to(y_true.device)\n",
        "        \n",
        "    correct = torch.eq(y_true, y_pred).sum().item()\n",
        "    acc = (correct / len(y_pred)) * 100\n",
        "    return acc"
      ]
